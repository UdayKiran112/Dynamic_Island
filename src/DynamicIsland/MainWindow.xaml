<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="300"
        Height="52"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Border x:Name="Shell"
                CornerRadius="26"
                BorderThickness="1"
                BorderBrush="{DynamicResource StrokeBrush}"
                ClipToBounds="True">
            <Grid>
                <Border Background="{DynamicResource WindowBgBrush}"
                        Opacity="{Binding Settings.BackgroundOpacity}" />

                <!-- ============ Compact pill ============ -->
                <Grid x:Name="CompactRoot"
                      Margin="14,0"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseLeftButtonUp="CompactRoot_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="9"
                            Background="{DynamicResource ArtPlaceholderBrush}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding MediaArtwork}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                            <Path Data="{StaticResource IconMusic}"
                                  Style="{StaticResource StrokeIconStyle}"
                                  Width="17" Height="17"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CompactTitle}" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="{Binding CompactSubtitle}"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   FontSize="10"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding ClockText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Visibility="{Binding Settings.ShowClock, Converter={StaticResource BoolToVisibility}}" />

                    <Path Grid.Column="3"
                          Data="{StaticResource IconChevronDown}"
                          Style="{StaticResource StrokeIconStyle}"
                          Width="14" Height="14"
                          VerticalAlignment="Center" />
                </Grid>

                <!-- ============ Expanded card ============ -->
                <Grid x:Name="ExpandedRoot"
                      Margin="16,12,16,14"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource ArtPlaceholderBrush}"
                                ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding MediaArtwork}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                                <Path Data="{StaticResource IconMusic}"
                                      Style="{StaticResource StrokeIconStyle}"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompactTitle}" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="{Binding CompactSubtitle}" Style="{StaticResource SubtitleTextStyle}" FontSize="10" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CollapseCommand}"
                                ToolTip="Collapse">
                            <Path Data="{StaticResource IconChevronUp}" Style="{StaticResource StrokeIconStyle}" Width="15" Height="15" />
                        </Button>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,8">
                        <RadioButton Content="Media" GroupName="Tabs"
                                     Style="{StaticResource TabRadioStyle}"
                                     IsChecked="{Binding IsMediaTab, Mode=TwoWay}" />
                        <RadioButton Content="Timer" GroupName="Tabs"
                                     Style="{StaticResource TabRadioStyle}"
                                     IsChecked="{Binding IsTimerTab, Mode=TwoWay}" />
                        <RadioButton Content="Stats" GroupName="Tabs"
                                     Style="{StaticResource TabRadioStyle}"
                                     IsChecked="{Binding IsStatsTab, Mode=TwoWay}" />
                        <RadioButton Content="Settings" GroupName="Tabs"
                                     Style="{StaticResource TabRadioStyle}"
                                     IsChecked="{Binding IsSettingsTab, Mode=TwoWay}" />
                    </UniformGrid>

                    <!-- Media tab -->
                    <Grid Grid.Row="2" Visibility="{Binding IsMediaTab, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="104" Height="104" CornerRadius="18"
                                    Background="{DynamicResource ArtPlaceholderBrush}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding MediaArtwork}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Data="{StaticResource IconMusic}"
                                          Style="{StaticResource StrokeIconStyle}"
                                          Width="32" Height="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           MaxHeight="52"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaArtist}"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           FontSize="12"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding MediaAlbum}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                                <Border Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="6"
                                        Padding="7,3"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding MediaSource, Converter={StaticResource StringToVisibility}}">
                                    <TextBlock Text="{Binding MediaSource}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <Path Data="{StaticResource IconMusic}"
                                  Style="{StaticResource StrokeIconStyle}"
                                  Width="34" Height="34"
                                  HorizontalAlignment="Center"
                                  Opacity="0.6" />
                            <TextBlock Text="Nothing playing"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Start something in Spotify, a browser or Media Player."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="250"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Style="{StaticResource StatProgressStyle}"
                                             Maximum="100"
                                             Value="{Binding MediaProgress, Mode=OneWay}" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource CaptionTextStyle}" FontSize="10" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="44" Height="44"
                                        Command="{Binding PreviousCommand}"
                                        ToolTip="Previous">
                                    <Path Data="{StaticResource IconPrevious}" Style="{StaticResource FilledIconStyle}" Width="18" Height="18" />
                                </Button>

                                <Button Style="{StaticResource PlayButtonStyle}"
                                        Command="{Binding PlayPauseCommand}"
                                        Margin="8,0"
                                        ToolTip="Play / pause">
                                    <Grid Width="22" Height="22">
                                        <Path Data="{StaticResource IconPause}"
                                              Style="{StaticResource FilledIconStyle}"
                                              Fill="{DynamicResource AccentTextBrush}"
                                              Width="20" Height="20"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                        <Path Data="{StaticResource IconPlay}"
                                              Style="{StaticResource FilledIconStyle}"
                                              Fill="{DynamicResource AccentTextBrush}"
                                              Width="20" Height="20"
                                              Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="44" Height="44"
                                        Command="{Binding NextCommand}"
                                        ToolTip="Next">
                                    <Path Data="{StaticResource IconNext}" Style="{StaticResource FilledIconStyle}" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Timer tab -->
                    <Grid Grid.Row="2" Visibility="{Binding IsTimerTab, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="ACTIVE TIMERS" Style="{StaticResource SectionTextStyle}" />
                            <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding Timers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                        <ProgressBar Style="{StaticResource StatProgressStyle}"
                                                                     Maximum="100"
                                                                     Value="{Binding Progress, Mode=OneWay}"
                                                                     Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RemainingText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,4,0" />
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Width="28" Height="28"
                                                            Command="{Binding DataContext.CancelTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Cancel">
                                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIconStyle}" Width="12" Height="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="No active timers"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="2,2,0,0"
                                       Visibility="{Binding HasTimers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="QUICK START" Style="{StaticResource SectionTextStyle}" />
                            <UniformGrid Columns="4" Margin="0,5,0,0">
                                <Button Content="1 min" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding StartTimerCommand}" CommandParameter="1" Margin="0,0,4,0" />
                                <Button Content="5 min" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding StartTimerCommand}" CommandParameter="5" Margin="2,0,2,0" />
                                <Button Content="10 min" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding StartTimerCommand}" CommandParameter="10" Margin="2,0,2,0" />
                                <Button Content="25 min" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding StartTimerCommand}" CommandParameter="25" Margin="4,0,0,0" />
                            </UniformGrid>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource IslandTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Minutes" />
                            <Button Grid.Column="1"
                                    Content="Start"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StartCustomTimerCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="STOPWATCH" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding StopwatchText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding StopwatchToggleText}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StopwatchToggleCommand}"
                                            MinWidth="64" />
                                    <Button Content="Reset"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding StopwatchResetCommand}"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Stats tab -->
                    <Grid Grid.Row="2" Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="CPU" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Style="{StaticResource StatProgressStyle}"
                                             Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="MEMORY" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Style="{StaticResource StatProgressStyle}"
                                             Maximum="100" Value="{Binding MemoryPercent, Mode=OneWay}" Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding NetworkDown}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="UPLOAD" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding NetworkUp}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="BATTERY" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="{Binding BatteryText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Style="{StaticResource StatProgressStyle}"
                                             Maximum="100" Value="{Binding BatteryPercent, Mode=OneWay}" Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Settings tab -->
                    <ScrollViewer Grid.Row="2"
                                  Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTextStyle}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Grid.Column="1" Width="140"
                                          Style="{StaticResource IslandComboBoxStyle}"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="1" Style="{StaticResource IslandSliderStyle}"
                                        Minimum="0.35" Maximum="1"
                                        Value="{Binding Settings.BackgroundOpacity, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Settings.BackgroundOpacity, StringFormat={}{0:P0}}"
                                           Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Scale" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="1" Style="{StaticResource IslandSliderStyle}"
                                        Minimum="0.75" Maximum="1.5"
                                        Value="{Binding Settings.Scale, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Settings.Scale, StringFormat={}{0:0.00}x}"
                                           Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="POSITION" Style="{StaticResource SectionTextStyle}" Margin="0,4,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Monitor" VerticalAlignment="Center" FontSize="12" />
                                <ComboBox Grid.Column="1" Width="210"
                                          Style="{StaticResource IslandComboBoxStyle}"
                                          ItemsSource="{Binding Monitors}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="DeviceName"
                                          SelectedValue="{Binding Settings.MonitorDeviceName, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Top offset" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="1" Style="{StaticResource IslandSliderStyle}"
                                        Minimum="0" Maximum="80"
                                        Value="{Binding Settings.TopOffset, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Settings.TopOffset, StringFormat={}{0:0} px}"
                                           Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionTextStyle}" Margin="0,4,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-hide in fullscreen" FontSize="12" />
                                    <TextBlock Text="Games, videos and presentations" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Settings.AutoHideFullscreen, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hover to expand" FontSize="12" />
                                    <TextBlock Text="Open after a short hover" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Settings.HoverToExpand, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Notifications" FontSize="12" />
                                    <TextBlock Text="Show alerts in the island" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Settings.NotificationsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Global hotkeys" FontSize="12" />
                                    <TextBlock Text="Ctrl+Alt+D / M / T" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Settings.EnableHotkeys, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Alert time" VerticalAlignment="Center" FontSize="12" />
                                <Slider Grid.Column="1" Style="{StaticResource IslandSliderStyle}"
                                        Minimum="2" Maximum="20"
                                        Value="{Binding Settings.NotificationDurationSeconds, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding Settings.NotificationDurationSeconds, StringFormat={}{0}s}"
                                           Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="SYSTEM" Style="{StaticResource SectionTextStyle}" Margin="0,4,0,6" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontSize="12" />
                                    <TextBlock Text="Launch at sign-in" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Reset" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ResetSettingsCommand}" />
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Quit" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding QuitCommand}" />
                            </Grid>

                            <Button Content="Test notification" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding TestNotificationCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,4,0,8" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="InlineBanner"
                            Grid.Row="2"
                            Panel.ZIndex="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource CardHoverBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,7"
                            Visibility="Collapsed"
                            Margin="0,2,0,0">
                        <TextBlock x:Name="InlineBannerText"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>

                <!-- ============ Notification peek ============ -->
                <Grid x:Name="PeekRoot"
                      Margin="16,0"
                      Background="Transparent"
                      Cursor="Hand"
                      Visibility="Collapsed"
                      MouseLeftButtonUp="PeekRoot_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBell}"
                              Style="{StaticResource StrokeIconStyle}"
                              Stroke="{DynamicResource AccentBrush}"
                              Width="19" Height="19"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PeekApp}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="250" />
                            <TextBlock Text="{Binding PeekTime}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PeekTitle}"
                                   Style="{StaticResource TitleTextStyle}"
                                   FontSize="13"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding PeekBody}"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   FontSize="10"
                                   MaxHeight="28"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Click="PeekClose_Click"
                            VerticalAlignment="Center"
                            ToolTip="Dismiss">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIconStyle}" Width="13" Height="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
