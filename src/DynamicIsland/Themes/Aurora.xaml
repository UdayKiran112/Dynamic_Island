<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBgBrush" Color="#F2081420" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FF0C1A28" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF122437" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF1A3148" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#2A7DE8D4" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2FFFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8FB6B2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5E8482" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF38E8C6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A38E8C6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF04120F" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF1C3548" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B8B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6EF3C4" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFD166" />

    <LinearGradientBrush x:Key="ArtPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1C3F4A" Offset="0" />
        <GradientStop Color="#FF10232F" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
