<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBgBrush" Color="#F20B0C10" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FF13141A" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF1C1E26" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF262934" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9BA1AF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7C5CFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#337C5CFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF2A2D37" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5C7A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24" />

    <LinearGradientBrush x:Key="ArtPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF323642" Offset="0" />
        <GradientStop Color="#FF1B1D24" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
